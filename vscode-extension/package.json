{
  "name": "snap-checkpoints",
  "displayName": "Snap - Local Checkpoints",
  "description": "Local development checkpoint tool — save, diff, and restore your code instantly without Git commits",
  "version": "1.1.0",
  "publisher": "nihalkumar",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "checkpoint",
    "backup",
    "snapshot",
    "save",
    "restore",
    "diff",
    "local"
  ],
  "activationEvents": [
    "workspaceContains:.snap"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "snap.init",
        "title": "Snap: Initialize",
        "icon": "$(folder-opened)"
      },
      {
        "command": "snap.save",
        "title": "Snap: Save Checkpoint",
        "icon": "$(save)"
      },
      {
        "command": "snap.restore",
        "title": "Snap: Restore Checkpoint",
        "icon": "$(discard)"
      },
      {
        "command": "snap.showFile",
        "title": "Snap: Show File at Checkpoint",
        "icon": "$(eye)"
      },
      {
        "command": "snap.diffFile",
        "title": "Snap: Diff File with Current",
        "icon": "$(diff)"
      },
      {
        "command": "snap.delete",
        "title": "Snap: Delete Checkpoint",
        "icon": "$(trash)"
      },
      {
        "command": "snap.saveFile",
        "title": "Snap: Save This File",
        "icon": "$(save)"
      },
      {
        "command": "snap.restoreFile",
        "title": "Snap: Restore This File",
        "icon": "$(discard)"
      },
      {
        "command": "snap.refresh",
        "title": "Snap: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "snap.export",
        "title": "Snap: Export Checkpoint",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "snap.import",
        "title": "Snap: Import Checkpoint",
        "icon": "$(cloud-download)"
      },
      {
        "command": "snap.compareFile",
        "title": "Snap: Compare File Between Checkpoints",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "snap.pin",
        "title": "Snap: Pin Checkpoint",
        "icon": "$(pin)"
      },
      {
        "command": "snap.unpin",
        "title": "Snap: Unpin Checkpoint",
        "icon": "$(pinned)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "snap-explorer",
          "title": "Snap Checkpoints",
          "icon": "$(bookmark)"
        }
      ]
    },
    "views": {
      "snap-explorer": [
        {
          "id": "snapTimeline",
          "name": "Timeline"
        },
        {
          "id": "snapChanges",
          "name": "Changes Since Last Snapshot"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "snap.save",
          "when": "view == snapTimeline",
          "group": "navigation"
        },
        {
          "command": "snap.import",
          "when": "view == snapTimeline",
          "group": "navigation"
        },
        {
          "command": "snap.refresh",
          "when": "view == snapTimeline",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "snap.saveFile",
          "group": "snap@1"
        }
      ],
      "explorer/context": [
        {
          "command": "snap.saveFile",
          "group": "snap@1"
        }
      ],
      "view/item/context": [
        {
          "command": "snap.pin",
          "when": "viewItem == snapshot",
          "group": "inline@1"
        },
        {
          "command": "snap.restore",
          "when": "viewItem == snapshot",
          "group": "inline@2"
        },
        {
          "command": "snap.delete",
          "when": "viewItem == snapshot",
          "group": "inline@3"
        },
        {
          "command": "snap.unpin",
          "when": "viewItem == snapshotPinned",
          "group": "inline@1"
        },
        {
          "command": "snap.restore",
          "when": "viewItem == snapshotPinned",
          "group": "inline@2"
        },
        {
          "command": "snap.delete",
          "when": "viewItem == snapshotPinned",
          "group": "inline@3"
        },
        {
          "command": "snap.pin",
          "when": "viewItem == snapshot",
          "group": "1_actions"
        },
        {
          "command": "snap.export",
          "when": "viewItem == snapshot",
          "group": "1_actions"
        },
        {
          "command": "snap.restore",
          "when": "viewItem == snapshot",
          "group": "1_actions"
        },
        {
          "command": "snap.delete",
          "when": "viewItem == snapshot",
          "group": "2_delete"
        },
        {
          "command": "snap.unpin",
          "when": "viewItem == snapshotPinned",
          "group": "1_actions"
        },
        {
          "command": "snap.export",
          "when": "viewItem == snapshotPinned",
          "group": "1_actions"
        },
        {
          "command": "snap.restore",
          "when": "viewItem == snapshotPinned",
          "group": "1_actions"
        },
        {
          "command": "snap.delete",
          "when": "viewItem == snapshotPinned",
          "group": "2_delete"
        },
        {
          "command": "snap.restoreFile",
          "when": "viewItem == snapshotFile",
          "group": "inline"
        },
        {
          "command": "snap.showFile",
          "when": "viewItem == snapshotFile",
          "group": "1_actions"
        },
        {
          "command": "snap.compareFile",
          "when": "viewItem == snapshotFile",
          "group": "1_actions"
        },
        {
          "command": "snap.restoreFile",
          "when": "viewItem == snapshotFile",
          "group": "1_actions"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  }
}
