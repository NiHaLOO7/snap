{
  "name": "snap-checkpoints",
  "displayName": "Snap - Local Checkpoints",
  "description": "Local development checkpoint tool — save, diff, and restore your code instantly without Git commits",
  "version": "1.3.0",
  "publisher": "nihalkumar",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "checkpoint",
    "backup",
    "snapshot",
    "save",
    "restore",
    "diff",
    "local",
    "recording",
    "timeline",
    "rewind",
    "search",
    "grep",
    "fuzzy"
  ],
  "activationEvents": [
    "workspaceContains:.snap"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "snap.init",
        "title": "Snap: Initialize",
        "icon": "$(folder-opened)"
      },
      {
        "command": "snap.save",
        "title": "Snap: Save Checkpoint",
        "icon": "$(save)"
      },
      {
        "command": "snap.restore",
        "title": "Snap: Restore Checkpoint",
        "icon": "$(discard)"
      },
      {
        "command": "snap.showFile",
        "title": "Snap: Show File at Checkpoint",
        "icon": "$(eye)"
      },
      {
        "command": "snap.diffFile",
        "title": "Snap: Diff File with Current",
        "icon": "$(diff)"
      },
      {
        "command": "snap.delete",
        "title": "Snap: Delete Checkpoint",
        "icon": "$(trash)"
      },
      {
        "command": "snap.saveFile",
        "title": "Snap: Save This File",
        "icon": "$(save)"
      },
      {
        "command": "snap.restoreFile",
        "title": "Snap: Restore This File",
        "icon": "$(discard)"
      },
      {
        "command": "snap.refresh",
        "title": "Snap: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "snap.export",
        "title": "Snap: Export Checkpoint",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "snap.import",
        "title": "Snap: Import Checkpoint",
        "icon": "$(cloud-download)"
      },
      {
        "command": "snap.compareFile",
        "title": "Snap: Compare File Between Checkpoints",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "snap.pin",
        "title": "Snap: Pin Checkpoint",
        "icon": "$(pin)"
      },
      {
        "command": "snap.unpin",
        "title": "Snap: Unpin Checkpoint",
        "icon": "$(pinned)"
      },
      {
        "command": "snap.recordToggle",
        "title": "Snap: Toggle Recording",
        "icon": "$(record)"
      },
      {
        "command": "snap.recordStart",
        "title": "Snap: Start Recording",
        "icon": "$(debug-start)"
      },
      {
        "command": "snap.recordStop",
        "title": "Snap: Stop Recording",
        "icon": "$(debug-stop)"
      },
      {
        "command": "snap.rewind",
        "title": "Snap: Rewind",
        "icon": "$(debug-step-back)"
      },
      {
        "command": "snap.diffTimelineChange",
        "title": "Snap: Diff with Current",
        "icon": "$(diff)"
      },
      {
        "command": "snap.showTimelineFile",
        "title": "Snap: Show File at This Point",
        "icon": "$(eye)"
      },
      {
        "command": "snap.diffTimelinePrevious",
        "title": "Snap: Diff with Previous Change",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "snap.restoreTimelineFile",
        "title": "Snap: Restore File to This Point",
        "icon": "$(discard)"
      },
      {
        "command": "snap.watchFile",
        "title": "Snap: Watch This File",
        "icon": "$(eye)"
      },
      {
        "command": "snap.unwatchFile",
        "title": "Snap: Unwatch File",
        "icon": "$(eye-closed)"
      },
      {
        "command": "snap.clean",
        "title": "Snap: Clean Snapshots",
        "icon": "$(trash)"
      },
      {
        "command": "snap.refreshTimeline",
        "title": "Snap: Refresh Timeline",
        "icon": "$(refresh)"
      },
      {
        "command": "snap.refreshWatch",
        "title": "Snap: Refresh Watched Files",
        "icon": "$(refresh)"
      },
      {
        "command": "snap.clearTimeline",
        "title": "Snap: Clear Recording Timeline",
        "icon": "$(clear-all)"
      },
      {
        "command": "snap.saveTimelineAsCheckpoint",
        "title": "Snap: Save as Checkpoint",
        "icon": "$(save)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "snap-explorer",
          "title": "Snap Checkpoints",
          "icon": "$(bookmark)"
        }
      ]
    },
    "views": {
      "snap-explorer": [
        {
          "id": "snapSearch",
          "name": "Search",
          "type": "webview",
          "visibility": "collapsed"
        },
        {
          "id": "snapTimeline",
          "name": "Checkpoints"
        },
        {
          "id": "snapRecordingTimeline",
          "name": "Recording Timeline"
        },
        {
          "id": "snapWatchedFiles",
          "name": "Watched Files"
        },
        {
          "id": "snapChanges",
          "name": "Changes Since Last Snapshot"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "snap.save",
          "when": "view == snapTimeline",
          "group": "navigation@1"
        },
        {
          "command": "snap.import",
          "when": "view == snapTimeline",
          "group": "navigation@2"
        },
        {
          "command": "snap.clean",
          "when": "view == snapTimeline",
          "group": "navigation@3"
        },
        {
          "command": "snap.refresh",
          "when": "view == snapTimeline",
          "group": "navigation@4"
        },
        {
          "command": "snap.recordToggle",
          "when": "view == snapRecordingTimeline",
          "group": "navigation@1"
        },
        {
          "command": "snap.rewind",
          "when": "view == snapRecordingTimeline",
          "group": "navigation@2"
        },
        {
          "command": "snap.clearTimeline",
          "when": "view == snapRecordingTimeline",
          "group": "navigation@3"
        },
        {
          "command": "snap.refreshTimeline",
          "when": "view == snapRecordingTimeline",
          "group": "navigation@4"
        },
        {
          "command": "snap.watchFile",
          "when": "view == snapWatchedFiles",
          "group": "navigation@1"
        },
        {
          "command": "snap.refreshWatch",
          "when": "view == snapWatchedFiles",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "snap.saveFile",
          "group": "snap@1"
        },
        {
          "command": "snap.watchFile",
          "group": "snap@2"
        }
      ],
      "explorer/context": [
        {
          "command": "snap.saveFile",
          "group": "snap@1"
        },
        {
          "command": "snap.watchFile",
          "group": "snap@2"
        }
      ],
      "view/item/context": [
        {
          "command": "snap.pin",
          "when": "viewItem == snapshot",
          "group": "inline@1"
        },
        {
          "command": "snap.restore",
          "when": "viewItem == snapshot",
          "group": "inline@2"
        },
        {
          "command": "snap.delete",
          "when": "viewItem == snapshot",
          "group": "inline@3"
        },
        {
          "command": "snap.unpin",
          "when": "viewItem == snapshotPinned",
          "group": "inline@1"
        },
        {
          "command": "snap.restore",
          "when": "viewItem == snapshotPinned",
          "group": "inline@2"
        },
        {
          "command": "snap.delete",
          "when": "viewItem == snapshotPinned",
          "group": "inline@3"
        },
        {
          "command": "snap.pin",
          "when": "viewItem == snapshot",
          "group": "1_actions"
        },
        {
          "command": "snap.export",
          "when": "viewItem == snapshot",
          "group": "1_actions"
        },
        {
          "command": "snap.restore",
          "when": "viewItem == snapshot",
          "group": "1_actions"
        },
        {
          "command": "snap.delete",
          "when": "viewItem == snapshot",
          "group": "2_delete"
        },
        {
          "command": "snap.unpin",
          "when": "viewItem == snapshotPinned",
          "group": "1_actions"
        },
        {
          "command": "snap.export",
          "when": "viewItem == snapshotPinned",
          "group": "1_actions"
        },
        {
          "command": "snap.restore",
          "when": "viewItem == snapshotPinned",
          "group": "1_actions"
        },
        {
          "command": "snap.delete",
          "when": "viewItem == snapshotPinned",
          "group": "2_delete"
        },
        {
          "command": "snap.restoreFile",
          "when": "viewItem == snapshotFile",
          "group": "inline"
        },
        {
          "command": "snap.showFile",
          "when": "viewItem == snapshotFile",
          "group": "1_actions"
        },
        {
          "command": "snap.compareFile",
          "when": "viewItem == snapshotFile",
          "group": "1_actions"
        },
        {
          "command": "snap.restoreFile",
          "when": "viewItem == snapshotFile",
          "group": "1_actions"
        },
        {
          "command": "snap.diffTimelineChange",
          "when": "viewItem == timelineChange",
          "group": "inline@1"
        },
        {
          "command": "snap.restoreTimelineFile",
          "when": "viewItem == timelineChange",
          "group": "inline@2"
        },
        {
          "command": "snap.showTimelineFile",
          "when": "viewItem == timelineChange",
          "group": "1_actions@1"
        },
        {
          "command": "snap.diffTimelineChange",
          "when": "viewItem == timelineChange",
          "group": "1_actions@2"
        },
        {
          "command": "snap.diffTimelinePrevious",
          "when": "viewItem == timelineChange",
          "group": "1_actions@3"
        },
        {
          "command": "snap.saveTimelineAsCheckpoint",
          "when": "viewItem == timelineChange",
          "group": "2_save"
        },
        {
          "command": "snap.restoreTimelineFile",
          "when": "viewItem == timelineChange",
          "group": "3_restore"
        },
        {
          "command": "snap.unwatchFile",
          "when": "viewItem == watchedFile",
          "group": "inline"
        },
        {
          "command": "snap.unwatchFile",
          "when": "viewItem == watchedFile",
          "group": "1_actions"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24"
  }
}
